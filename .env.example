# Required for real answer generation. Without this, retrieval can run but
# /api/chat returns an explicit error instead of generated local text.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Keep local for the cheapest demo. If you change this to openai, reset/reseed
# Neo4j because vector dimensions will change.
EMBEDDING_PROVIDER=local

# Local Docker database defaults:
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=local-password
# MONGO_URI=mongodb://localhost:27017/sesamekiller_compass

# Cloud database examples:
# NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=replace_with_aura_password
# MONGO_URI=mongodb+srv://app_user:replace_with_password@cluster0.xxxxx.mongodb.net/sesamekiller_compass?retryWrites=true&w=majority&appName=sesamekiller-compass

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=local-password
MONGO_URI=mongodb://localhost:27017/sesamekiller_compass

# For cloud Compose, keep AUTO_SEED=false unless you intentionally want to seed
# the sample airport demo graph into AuraDB.
AUTO_SEED=true

RAG_SERVICE_URL=http://localhost:5001
JWT_SECRET=local-development-secret

# Optional public-data fetcher controls. The fetcher uses a clear user agent,
# respects robots.txt for official web pages, and writes JSON + CSV exports.
DATA_FETCHER_USER_AGENT=SesameKiller-CompassBot/0.1 (+https://github.com/SesameKiller113/SesameKiller-Compass)
OVERPASS_ENDPOINT=https://overpass-api.de/api/interpreter
OSM_ASSOCIATION_MODE=area-first
OVERPASS_MAX_RETRIES=2
OVERPASS_RETRY_BACKOFF_MS=30000
FETCH_DELAY_MS=3000


# Optional future data-provider credentials. Leave blank unless the provider has
# approved your use case and terms allow storage/use of the returned data.
FOURSQUARE_API_KEY=
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACES_LIMIT=
VISA_API_KEY=
VISA_SHARED_SECRET=
VISA_MERCHANT_SEARCH_USER_ID=
VISA_MERCHANT_SEARCH_PASSWORD=
VISA_MERCHANT_SEARCH_CERT_PATH=
VISA_MERCHANT_SEARCH_KEY_PATH=
MASTERCARD_CONSUMER_KEY=
MASTERCARD_KEYSTORE_PATH=
MASTERCARD_KEYSTORE_PASSWORD=
MASTERCARD_SIGNING_KEY_ALIAS=
AMEX_PARTNER_ACCOUNT_ID=
AMEX_API_KEY=
STRIPE_API_KEY=
SQUARE_ACCESS_TOKEN=
TOAST_CLIENT_ID=
TOAST_CLIENT_SECRET=
KARD_CLIENT_ID=
KARD_CLIENT_SECRET=
KARD_ORGANIZATION_ID=
FIDEL_API_KEY=
FIDEL_PROGRAM_ID=
OFFERLOVE_API_KEY=
CARD_BENEFITS_FILE=data/manual/card_benefits.local.json
